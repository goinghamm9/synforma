# All optional. Without a key Synforma runs the heuristic planner and says so in the UI.
# Keys are read on the server only and never reach the browser.

# Claude (preferred when both keys are set). Default model: claude-opus-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI. Default model: gpt-5-mini (OPENAI_BASE_URL points at a compatible gateway).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Gemini. Default model: gemini-2.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=

# Grok through xAI's OpenAI-compatible API. Default model: grok-4-fast-non-reasoning (GROK_API_KEY / GROK_MODEL are accepted too).
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=

# Pin a vendor when several keys are present: claude | openai | gemini | grok (otherwise the first configured in that order)
PLANNER_PROVIDER=

# System One decisions (Jev by TypeSafe): consulted only when the lexical rules are unsure which field is which.
# Either route works; TypeSafe's API is preferred when both are set (DECISION_PROVIDER=cloudflare|typesafe pins one).
# Cloudflare Workers AI: an account id and an API token with Workers AI read + edit (model typesafe/jev).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# TypeSafe's own API (model jev-latest).
TYPESAFE_API_KEY=
# Optional: model id override on either route; pin a route when both are configured.
JEV_MODEL=
DECISION_PROVIDER=
